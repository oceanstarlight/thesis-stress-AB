# SEC EDGAR는 키가 없지만 연락처가 담긴 User-Agent를 요구한다. 예: "riskprobe you@example.com"
SEC_USER_AGENT=
# OpenDART: https://opendart.fss.or.kr (무료, 일 20,000건)
DART_API_KEY=
# 선택: 한국은행 ECOS (https://ecos.bok.or.kr/api, 무료). 한국 기업 금리 경로(CD 91일·국고채 3년)에 쓴다.
ECOS_API_KEY=
# 선택: LLM (P2부터 사용). 키가 없으면 규칙 기반으로 동작한다.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
